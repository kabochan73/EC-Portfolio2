APP_NAME=EC-PORTFOLIO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# BFF のフロント（メール内リンク・CORS 許可元の base）
FRONTEND_URL=http://localhost:3000

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# docker-compose.yml の db サービス（postgres:16-alpine）に接続する。
# ホスト名はコンテナ名 "db"（127.0.0.1 はコンテナ内では自分自身）。
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ecp
DB_USERNAME=ecp
DB_PASSWORD=ecpsecret

# トークン認証のみ。web セッションは使わない
SESSION_DRIVER=array
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── メール（ローカルは Mailpit。docs/10-email.md）──────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@ec-portfolio.example.jp"
MAIL_FROM_NAME="${APP_NAME}"
# 本番は MAIL_MAILER=resend + RESEND_API_KEY
RESEND_API_KEY=

# ── S3 互換ストレージ（ローカルは RustFS。docs/05-admin.md）──
AWS_ACCESS_KEY_ID=ecp
AWS_SECRET_ACCESS_KEY=ecpsecret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=ec-portfolio-media
AWS_ENDPOINT=http://rustfs:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ── Stripe（test mode。docs/09-payments-stripe.md）─────────
# 未入手なら空でよい（決済ページに進むまでエラーにならない）。
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# `stripe listen` が表示する whsec_... を入れて backend/queue を restart
STRIPE_WEBHOOK_SECRET=

# ── BFF との共有シークレット（ResolveBffClientIp。レート制限用の実クライアント IP）─
# frontend/.env.local の BFF_SHARED_SECRET と同じ値。`openssl rand -hex 32` で生成
BFF_SHARED_SECRET=

# ── 管理者アカウント（AdminUserSeeder。config/admin.php）─────
# 未設定なら Store Admin / admin@ec-portfolio.example.jp / password にフォールバック
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
